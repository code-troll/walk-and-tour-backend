PORT=3000
NODE_ENV=development
APP_NAME=walk-and-tour-backend
APP_BASE_URL=http://api.dev.walkandtour.dk:3000
NEWSLETTER_PUBLIC_APP_BASE_URL=http://dev.walkandtour.dk:3001
CORS_ALLOWED_ORIGINS=http://admin.dev.walkandtour.dk:3001,http://dev.walkandtour.dk:3001,http://localhost:3001
MEDIA_IMAGE_MAX_UPLOAD_BYTES=10485760
MEDIA_VIDEO_MAX_UPLOAD_BYTES=104857600
DB_HOST=localhost
DB_PORT=5432
DB_NAME=walk_and_tour
DB_USER=postgres
DB_PASSWORD=postgres
AUTH0_ISSUER_BASE_URL=https://dev-d6cba0cbx4c6cfjh.us.auth0.com
AUTH0_AUDIENCE=http://api.dev.walkandtour.dk/api
AUTH_BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
AUTH_BOOTSTRAP_SUPER_ADMIN_SUB=
EMAIL_PROVIDER=console
EMAIL_FROM="Walk and Tour <no-reply@example.com>"
RESEND_API_KEY=
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=storage
LOCAL_STORAGE_PUBLIC_BASE_URL=http://api.dev.walkandtour.dk:3000/media
RAILWAY_STORAGE_ENDPOINT=
RAILWAY_STORAGE_ACCESS_KEY_ID=
RAILWAY_STORAGE_SECRET_ACCESS_KEY=
RAILWAY_STORAGE_REGION=auto
RAILWAY_STORAGE_BUCKET=
RAILWAY_STORAGE_URL_STYLE=virtual-hosted
# Identity provider for hotel access users. `console` logs the password setup
# link instead of creating a real identity, and is the safe default.
IDENTITY_PROVIDER=console
# Auth0 tenant used for hotel identities. Falls back to AUTH0_ISSUER_BASE_URL.
IDENTITY_ISSUER_BASE_URL=
# Machine-to-machine application authorised for the Auth0 Management API with
# create:users, read:users, update:users, delete:users and create:user_tickets.
IDENTITY_MANAGEMENT_CLIENT_ID=
IDENTITY_MANAGEMENT_CLIENT_SECRET=
# Auth0 database connection holding hotel access users. It needs username
# login enabled and a username length range wide enough for real hotel names.
HOTEL_IDENTITY_CONNECTION=Hotel-Portal-Users
# Base URL of the hotel portal, used for password setup return links.
HOTEL_PORTAL_BASE_URL=http://hotels.dev.walkandtour.dk:3001
# Default IANA timezone applied to new events when the admin does not specify one.
DEFAULT_EVENT_TIMEZONE=Europe/Copenhagen
